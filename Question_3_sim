###steering function

k_h = 1 #horizontal gain
k_v = 1 #vertical gain
k_d = 1 #derivative gain


def steering_input(x,move_to):
    x_pos = (rm/2)*(x[0]+x[1])
    y_pos = (rm/2)*(x[0]-x[1])
    delta_x = move_to[0] - x_pos
    delta_y = move_to[1] - y_pos

    vx = (rm/2)*(x[3]+x[4])
    vy = (rm/2)*(x[3]-x[4])
    
    U_L = k_h*delta_x + k_v*delta_y - k_d*vx - k_d*vy
    U_R = k_h*delta_x + k_v*delta_y - k_d*vx + k_d*vy
    return U_L,U_R


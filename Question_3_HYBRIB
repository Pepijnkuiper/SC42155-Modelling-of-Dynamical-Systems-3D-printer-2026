###initialize
reset_point_th = (0,0)
x = np.zeros(9)
L_fc = 1.5 #how much filament we have now
f_color = 0 #colour 0 is loaded
L_nf = 1.5 #length of new filament that is loaded


x[8] = T_env

u = np.array([0.0, 0.0, 0.0, T_env])
printed_x, printed_y, printed_c = [], [], []
refill_x, refill_y = [], []
mode_history = []
mode_times = []
segment_id = 0 #which segment are we working on now
saved_point = (0,0)


time_elapsed = 0.0
mode = 0 #Travel
mode_history.append(mode)
mode_times.append(time_elapsed)

print("mode is",mode)
###
while mode != 8: #while not finished
    th1_des,th2_des = xy_to_theta(program_xy[segment_id,0],program_xy[segment_id,1])
    #desired motor angles from program for segment
    target_color = int(program_xy[segment_id,2])
    
    dist_target = np.hypot(th1_des - x[0], th2_des - x[1])
    dist_reset  = np.hypot(reset_point_th[0] - x[0], reset_point_th[1] - x[1])
    dist_return = np.hypot(saved_point[0] - x[0], saved_point[1] - x[1])
    
    if mode == 0: #travel
        if dist_target <= allowed_theta_error:
            segment_id += 1
            if segment_id >= len(program_xy):
                mode = 8 #finished
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
                break
            next_segment_color = int(program_xy[segment_id, 2])
            next_segment_print = int(program_xy[segment_id, 3])
            if next_segment_print == 0:
                mode = 0 #travel
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            elif f_color != next_segment_color or L_fc <= allowed_filament_rest:
                saved_point = (x[0], x[1])
                rx, ry = theta_to_xy(x[0], x[1])
                refill_x.append(rx)
                refill_y.append(ry)
                mode = 3 #to reset point
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            elif x[8] < min_T_print:
                mode = 1 #heat
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            else:
                mode = 2 #print
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
                
    #### Heating mode
    elif mode == 1: #heat
        if x[8] >= min_T_print:
            mode = 2#print
            print("mode switched to", mode)
            mode_history.append(mode)
            mode_times.append(time_elapsed)
    ##printing mode
    elif mode == 2: #print
        if f_color != target_color or L_fc <= allowed_filament_rest:
            saved_point = (x[0], x[1])
            rx, ry = theta_to_xy(x[0], x[1])
            refill_x.append(rx)
            refill_y.append(ry)
            mode = 3 # move to the reset point
            print("mode switched to", mode)
            mode_history.append(mode)
            mode_times.append(time_elapsed)
        elif x[8] < min_T_print:
            mode = 1 #heat
            print("mode switched to", mode)
            mode_history.append(mode)
            mode_times.append(time_elapsed)
        elif dist_target <= allowed_theta_error:
            segment_id = segment_id+1
            if segment_id >= len(program_xy):
                mode = 8 #finished
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
                break
            
            next_color = int(program_xy[segment_id, 2])
            next_print = int(program_xy[segment_id, 3])
            if next_print == 0:
                mode = 0 #travel
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            elif f_color != next_color or L_fc <= allowed_filament_rest:
                saved_point = (x[0], x[1])
                rx, ry = theta_to_xy(x[0], x[1])
                refill_x.append(rx)
                refill_y.append(ry)
                mode = 3 #to reset
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
    
    #moving to the reset point
    elif mode == 3: #to reset
        if dist_reset <= allowed_theta_error:
            if L_fc > allowed_filament_rest:
                mode = 4 #empying
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            else:
                mode = 5 #
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
                #reload
                
    #emptying at the reset point
    elif mode == 4:#emptying
        if L_fc <= allowed_filament_rest:
            mode = 5 #cool
            print("mode switched to", mode)
            mode_history.append(mode)
            mode_times.append(time_elapsed)
   
    #Cooling, w/o movement only occur at the reset point
    elif mode == 5: #cooling w/o movement
        if x[8] <= max_T_rep:
            mode = 6
            print("mode switched to", mode)
            mode_history.append(mode)
            mode_times.append(time_elapsed)
    
    #instantly reload at the reset point
    elif mode == 6: #reload
        f_color = target_color #grabs target color for current segment id and loads it
        L_fc = L_nf
        mode = 7 #return
        print("mode switched to", mode)
        mode_history.append(mode)
        mode_times.append(time_elapsed)
        
    #return to the saved return point
    elif mode == 7: #return
        if dist_return <= allowed_theta_error:
            if x[8] < min_T_print:
                mode = 1#heat
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            else:
                mode = 2 #print
                print("mode switched to", mode)
                mode_history.append(mode)
                mode_times.append(time_elapsed)
            #mode heat =1
    th1_des, th2_des = xy_to_theta(program_xy[segment_id, 0], program_xy[segment_id, 1])
    target_color = int(program_xy[segment_id, 2])
#dynamics and inputs per mode etc
    if mode == 0: #travel
        u[0:2] = steering_command(x, th1_des, th2_des, DRIVE_VOLTAGE)
        u[2] = 0.0

    elif mode == 1: #heat
        u[0:2] = [0.0, 0.0]
        u[2] = U_H_on
        #heat maybe already be on

    elif mode == 2: #print
        u[0:2] = steering_command(x, th1_des, th2_des, DRIVE_VOLTAGE)
        u[2] = U_H_on
        L_fc -= max_print_rate * dt
        px, py = theta_to_xy(x[0], x[1])#save where printing was done
        printed_x.append(px)
        printed_y.append(py)
        printed_c.append(f_color) #fills the array with the points of where printing was done

    elif mode == 3: #to reset point
        u[0:2] = steering_command(x, reset_point_th[0], reset_point_th[1], DRIVE_VOLTAGE)
        if L_fc > allowed_filament_rest:
            u[2] = U_H_on #logic to save energy and time, not really within scope here.
        else:
            u[2] = 0
    elif mode == 4:#empyting
        u[0:2] = [0.0, 0.0] #turns off the movement voltages
        u[2] = U_H_on #heater on
        if x[8] >= min_T_print:
            L_fc -= max_print_rate * dt

    elif mode == 5: #Cooling W/O moving
        u[0:2] = [0.0, 0.0] #setting drive volages to zero again
        u[2] = 0.0 #turn off heater

    elif mode == 6: #reload
        u[0:2] = [0.0, 0.0] #voltages here are already zero but this does not matter
        u[2] = 0.0 #heater is also already off before this
        
    elif mode == 7: #return
        u[0:2] = steering_command(x, saved_point[0], saved_point[1], DRIVE_VOLTAGE)
        u[2] = U_H_on #put the heater on to save time
    #do the update now
    x_dot = f(x, u)
    x = x+ x_dot *dt
    time_elapsed = time_elapsed + dt
    #new state is calculated for the loop to run again.

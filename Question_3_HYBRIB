#this controller yielded huge overshoots. need to slow down as car approach setpoint
#but also not exceed the amplitude of drive voltage.

kd = 0.1 #currently this gain does not result in an override for the square.
kv = 0.0 #set to zero, dampeners in system were enough anyway and this destroys the shape somehow if large.
def steering_command(x, th1_des, th2_des, V):
    delta_thL = th1_des - x[0]
    delta_thR = th2_des - x[1]
    
    u_L = delta_thL *kd   - kv *x[2]
    u_R = delta_thR *kd- kv * x[3]
    SV = np.array([u_L,u_R]) #Steering voltages
    
    
    TV = np.linalg.norm(SV) #Total steering voltage
    if  TV > V:
        u_L = (u_L*V)/TV
        u_R = (u_R*V)/TV #scaling steering voltage to conserve shape
        print("voltage override was necessary BC drive voltage was",TV)
    return u_L, u_R



def f(x, u):
    x_dot = np.zeros(9)
    x_dot[0:6] = A @ x[0:6] + B @ u[0:2]
    x_dot[6] = (u[2] - x[7]) / Ln
    x_dot[7] = (x[6] * Rn - x[7]) / (Cn * Rn)
    x_dot[8] = ((x[7]**2 / Rn) - ((x[8] - u[3]) / Rt_n)) / Ct_n
    return x_dot

#automaton states
#travel = 0 #moving without printing to target point
#heat = 1 #waiting to heat up without moving
#print = 2 #printing while moving to target point
#move to reset = 3 #moving to reset point
#emptying = 4 #emptying rest of filament
#cooling = 5 #cooling down without moving
#reload = 6 # reloading filament
#return = 7 # returning to previous print location
#finished = 8 # done with program
#other parameters
T_env = 298.15 #kelvin benjamijns
min_T_print = 373.15#kevin austins
max_T_rep = 323.15#kelvins
U_H_on = 24.0#heater voltage when on
max_print_rate = 0.1 
allowed_filament_rest = 0.02
allowed_theta_error = 0.1  # Sensor guard threshold [rad]
DRIVE_VOLTAGE = 12.0        # Constant voltage magnitude

#program [x, y, color, 1 = print 0 = not print]
program_xy = np.array([
    [1, 1, 0, 0], #BL corner
    [1, 2, 0, 1],#TL corner
    [2, 2, 1, 1],#TR corner also switch color here
    [2, 1, 1, 1],#BR corner
    [1, 1, 1, 1]  #BL corner
], dtype=float)


